#!/bin/bash
# SPDX-License-Identifier: AGPL-3.0-only
# Migrations and grants run as the table-owner role (non-superuser, FORCE RLS applies) in platform context.
set -o errexit -o pipefail -o nounset
MEALTALLY_DB_OWNER_MODE=1 python manage.py migrate --noinput
MEALTALLY_DB_OWNER_MODE=1 python manage.py db_setup
MEALTALLY_DB_OWNER_MODE=1 python manage.py check_rls

# Only trust X-Forwarded-Proto when a reverse proxy sits in front (MEALTALLY_TRUST_PROXY=true).
if [[ "${MEALTALLY_TRUST_PROXY:-false}" == "true" ]]; then
  forwarded="${MEALTALLY_FORWARDED_ALLOW_IPS:-*}"
else
  forwarded="127.0.0.1"
fi
exec gunicorn config.wsgi \
  --bind 0.0.0.0:8000 \
  --workers "${WEB_CONCURRENCY:-3}" \
  --forwarded-allow-ips "${forwarded}" \
  --access-logfile - \
  --chdir=/app
