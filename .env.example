# Mealtally configuration. `make init` copies this to .env and fills in every empty secret.
# Everything is documented in docs/configuration.md.

# --- Where people reach Mealtally ------------------------------------------------------------------------------------
# The address people type. http:// keeps secure cookies, the HTTPS redirect and HSTS off; https:// turns them on.
# On plain http:// the counter's camera QR scan and the app install only work on localhost (docs/deploy.md).
MEALTALLY_BASE_URL=http://localhost:8000
MEALTALLY_PORT=8000
# Which host address the port listens on: 0.0.0.0 (every network, for phones on the LAN) or 127.0.0.1 (this machine
# only, for example behind a reverse proxy on the same host).
MEALTALLY_BIND=0.0.0.0
# Set to true only when a reverse proxy (Caddy, Traefik, nginx) sits in front and sets X-Forwarded-Proto.
MEALTALLY_TRUST_PROXY=false

# --- Mode and features -------------------------------------------------------------------------------------------------
# single: one restaurant (the default). multi: host many restaurants (tenant finder, onboarding).
MEALTALLY_MODE=single
# production (default) or development. `make demo` only runs in development.
MEALTALLY_ENV=production
# Operator features, all off unless you need them.
MEALTALLY_PLATFORM_FEES=off
MEALTALLY_MARKETING_SITE=off
# on: new restaurants also show the Preview modules (wallet, orders, kitchen, delivery, invoices, ...) filled with
# sample data and labelled "Preview". They are not working features yet. `make demo` turns them on for its own
# restaurants either way.
MEALTALLY_DEMO_DATASET=off
MEALTALLY_LEGAL_PAGES=off

# --- First restaurant and admin ------------------------------------------------------------------------------------
# `make init` creates the platform admin with this email (and, in single mode, the restaurant and its owner).
MEALTALLY_ADMIN_EMAIL=
MEALTALLY_RESTAURANT_NAME=My Restaurant
# Required, no built-in default (`make init` asks): the country (ISO 3166, e.g. IN, US, GB), currency
# (ISO 4217, e.g. INR, USD, GBP) and time zone (e.g. Asia/Kolkata, America/New_York) of new restaurants.
MEALTALLY_DEFAULT_COUNTRY=
MEALTALLY_DEFAULT_CURRENCY=
MEALTALLY_DEFAULT_TIMEZONE=
MEALTALLY_DEFAULT_LANGUAGE=en

# --- Secrets (left empty here; `make init` generates them into .env) ---------------------------------------------------
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
MEALTALLY_DB_OWNER_PASSWORD=
MEALTALLY_DB_APP_PASSWORD=

# --- Database --------------------------------------------------------------------------------------------------------
POSTGRES_DB=mealtally
POSTGRES_USER=mealtally_admin
POSTGRES_PORT=5432

# --- Email (optional; without it, PINs and passwords are shown on screen once) ----------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
MEALTALLY_FROM_EMAIL=

# --- Backups (compose.prod.yml) ------------------------------------------------------------------------------------
MEALTALLY_BACKUP_AT_UTC=20:30
MEALTALLY_BACKUP_RETENTION_DAYS=14
# The host user and group that own ./backups (make init fills these in with yours).
MEALTALLY_UID=
MEALTALLY_GID=

# --- Production image (compose.prod.yml) ---------------------------------------------------------------------------
# MEALTALLY_IMAGE=ghcr.io/<owner>/mealtally:0.1.2
# MEALTALLY_POSTGRES_IMAGE=ghcr.io/<owner>/mealtally-postgres:0.1.2

# --- Optional -------------------------------------------------------------------------------------------------------
WEB_CONCURRENCY=3
SENTRY_DSN=
